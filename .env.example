# Modelo do .env local. scripts/iniciar-local.sh copia para .env e troca cada SUBSTITUA_*
# por um valor aleatório (nunca sobrescreve um .env existente). Não commite o .env.

# Imagens mateusblm/nexfleet-*:<tag> do Docker Hub.
NEXFLEET_TAG=latest
# mongo:8 não sobe em kernel Linux >= 6.19 (SERVER-121912); mongo:7.0 sobe em qualquer um.
MONGO_IMAGE=mongo:7.0

# Portas publicadas em 127.0.0.1 (troque se já estiverem em uso).
GATEWAY_PORT=8080
SQLSERVER_PORT=14330
MONGO_PORT=27018
RABBITMQ_MGMT_PORT=15672
FUNCTION_PORT=17071

# SQL Server: senha do sa e um usuário contido por serviço (infra/sqlserver/bootstrap.sql).
# Senhas sem aspas simples; o SQL Server exige 8+ caracteres com maiúscula, minúscula e dígito.
NEXFLEET_DB=nexfleet
MSSQL_SA_PASSWORD=SUBSTITUA_MSSQL_SA_PASSWORD
IDENTIDADE_DB_PASSWORD=SUBSTITUA_IDENTIDADE_DB_PASSWORD
OPERACOES_DB_PASSWORD=SUBSTITUA_OPERACOES_DB_PASSWORD
INDICADORES_DB_PASSWORD=SUBSTITUA_INDICADORES_DB_PASSWORD
NOTIFICACOES_DB_PASSWORD=SUBSTITUA_NOTIFICACOES_DB_PASSWORD

# MongoDB da Frota. Na Azure, MONGODB_URI é a connection string do Atlas.
# serverSelectionTimeoutMS=3000: sem ele o readiness trava 30 s com o Mongo fora.
MONGO_ROOT_USER=nexfleet
MONGO_ROOT_PASSWORD=SUBSTITUA_MONGO_ROOT_PASSWORD
MONGODB_URI='mongodb://nexfleet:SUBSTITUA_MONGO_ROOT_PASSWORD@mongodb:27017/?authSource=admin&serverSelectionTimeoutMS=3000'
MONGODB_DATABASE=frota

# RabbitMQ (eventos locais; na Azure é Service Bus).
RABBITMQ_USER=nexfleet
RABBITMQ_PASSWORD=SUBSTITUA_RABBITMQ_PASSWORD

# Chave RSA privada (PKCS#8) da Identidade: scripts/gerar-chave-jwt.sh.
JWT_PRIVATE_KEY_FILE=./.secrets/identidade-jwt.pem

# Administrador criado pelo perfil local-seed da Identidade (só se não existir).
IDENTIDADE_PROFILES=jwt-rsa,local-seed
LOCAL_USER_EMAIL=admin@nexfleet.local
LOCAL_USER_PASSWORD=SUBSTITUA_LOCAL_USER_PASSWORD
LOCAL_USER_PROFILE=ADMINISTRADOR

# Gateway → serviços (rotas da API e /docs/<svc>/v3/api-docs da Swagger UI).
BFF_URL=http://bff:8080
IDENTIDADE_URL=http://identidade:8080
FROTA_URL=http://frota:8080
OPERACOES_URL=http://operacoes:8080
INDICADORES_URL=http://indicadores:8080

# BFF → Function HTTP (POST /api/calcular-eficiencia, cabeçalho x-functions-key).
# Localmente o host de Functions lê as chaves de infra/function/iniciar-com-chaves.sh.
EFICIENCIA_FUNCTION_URL=http://function:80
EFICIENCIA_FUNCTION_KEY=SUBSTITUA_EFICIENCIA_FUNCTION_KEY
FUNCTION_MASTER_KEY=SUBSTITUA_FUNCTION_MASTER_KEY

# Limites de memória dos contêineres Java (SQL Server fica em 2 GB).
JAVA_MEM_LIMIT=512m
JAVA_SMALL_MEM_LIMIT=448m
FUNCTION_MEM_LIMIT=640m
